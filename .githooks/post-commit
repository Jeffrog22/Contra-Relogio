#!/bin/sh
# post-commit: sincroniza package.json no commit e cria a tag SemVer.
# Lógica de bump centralizada em semver-bump.sh (mesma fonte do commit-msg).
#
# O staging feito no commit-msg NÃO entra no commit: o git grava o tree a partir
# do índice em memória, carregado antes de rodar o hook. Aqui garantimos com um
# amend — que dispara post-commit de novo, por isso o guard SEMVER_SELFCHECK.

[ -n "$SEMVER_SELFCHECK" ] && exit 0

SUBJECT=$(git log -1 --format="%s")
BODY=$(git log -1 --format="%b")

NEW_TAG=$(sh "$(dirname "$0")/semver-bump.sh" "$SUBJECT" "$BODY")
VERSION=${NEW_TAG#v}

HEAD_VER=$(git show HEAD:package.json 2>/dev/null | node -p "JSON.parse(require('fs').readFileSync(0,'utf8')).version" 2>/dev/null || echo "")

if [ "$HEAD_VER" != "$VERSION" ]; then
  DISK_VER=$(node -p "require('./package.json').version" 2>/dev/null || echo "")
  if [ "$DISK_VER" != "$VERSION" ]; then
    node -e "
const fs = require('fs');
const pkg = JSON.parse(fs.readFileSync('package.json', 'utf8'));
pkg.version = '$VERSION';
fs.writeFileSync('package.json', JSON.stringify(pkg, null, 2) + '\n');
const lock = JSON.parse(fs.readFileSync('package-lock.json', 'utf8'));
lock.version = '$VERSION';
if (lock.packages && lock.packages['']) lock.packages[''].version = '$VERSION';
fs.writeFileSync('package-lock.json', JSON.stringify(lock, null, 2) + '\n');
"
  fi
  git add package.json package-lock.json
  export SEMVER_SELFCHECK=1
  if git commit --amend --no-edit --no-verify; then
    echo "post-commit: package.json=$VERSION sincronizado no commit via amend"
  else
    echo "post-commit: WARN - package.json=$VERSION nao entrou no commit (amend falhou)" >&2
  fi
fi

git tag "$NEW_TAG"
echo "post-commit: created tag $NEW_TAG"
